# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database (MongoDB Atlas, database name: najeeb_portfolio) ───
MONGODB_URI=mongodb://127.0.0.1:27017/najeeb_portfolio

# ─── Auth ──────────────────────────────────────────────
AUTH_SECRET=                 # openssl rand -base64 32
ADMIN_EMAIL=                 # used by: pnpm create-admin
ADMIN_PASSWORD=              # used by: pnpm create-admin (min 10 chars). Remove after use.

# ─── ImageKit (images + resume) ────────────────────────
# Dashboard → Developer options → API keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=       # e.g. https://ik.imagekit.io/your_id
IMAGEKIT_ROOT_FOLDER=/najeeb-portfolio
IMAGEKIT_MAX_STORAGE_MB=18000   # optional: refuse uploads once the site uses this much storage

# ─── Email (Resend) ────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Portfolio <onboarding@resend.dev>"
CONTACT_TO_EMAIL=            # defaults to the public email in Profile
EMAIL_TRANSPORT=resend       # resend | log  (log = print emails to console, for dev/tests)

# ─── Security / misc ───────────────────────────────────
IP_HASH_SALT=                # any long random string
TURNSTILE_SITE_KEY=          # optional (Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=        # optional
NEXT_PUBLIC_ANALYTICS=0      # 1 = load Vercel Web Analytics (also needs the SEO → Analytics switch)
